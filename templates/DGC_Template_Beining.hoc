begintemplate DGC

// GCL - granular layer dendrite
// IML - proximal dendrite
// MML - middle dendrite
// OML - distal dendrite

public all, soma, axon, allaxon, ais, hillock, apical, basal
public nDends, nGCL, nIML, nMML, nOML
public GCLidxs, IMLidxs, MMLidxs, OMLidxs
public verbose
public is_art, position, connect2target
public xx, yy, zz

verbose = 0
id  = -1
gid = -1

create sections[1]

objref GCLs, IMLs, MMLs, OMLs, all, soma, axon, allaxon, ais, hillock, apical, basal
objref GCLidxs, IMLidxs, MMLidxs, OMLidxs
objref apicalidx, basalidx, somaidx, axonidx, aisidx, hilidx
objref pyenv

iterator pyitr() {local i, k, x, n, sz localobj itr1, itrn
    sz = $1
    n = (numarg()-1) / 2
    i = 1+n+1
    itr1 = $oi
    
    for k = 0, sz-1 {
        for x = 1, n {
            i = 1+n+x
            itrn = $oi
            i = 1+x
            $&i = itrn.__next__()
        }
        iterator_statement
    }
}
                                
proc assert() { local test strdef errmsg
    
    test = $1
    errmsg = $s2
    
    if (!test) {
        execerror ("Assertion failed: ", errmsg)
    }
}


proc init() {
    
    gid = $1
    
    xx = 0
    yy = 0
    zz = 0
    
    pyenv = new PythonObject()
    nrnpython("import numpy as np")
    celldef($o3,$o4,$o5,$o6,$o7,$o8,$o9,$o10,$o11,$o12)
}


proc parameters() {
    
    celsius = 24
    v_init = -75

    //Passive properties
    Ra0 = 200         //Ohm.cm
    cm0 = 0.9         //uF/cm2
    gpas = 1.38462e-05 //S/cm2
    Rm0 = 1e-3/gpas   //kOhm.cm2
    Epas = -80        //mV
    EK = -93         //mV 
    ENa  = 87.76
    
    cm_IML = 1.305
    cm_MML = 1.71
    cm_OML = 1.71

    gpas_soma = gpas    
    gpas_IML = 2.00769e-05
    gpas_MML = 2.63076e-05
    gpas_OML = 2.63076e-05
    gpas_axon = 6.59341e-06
    
    Ra_axon = 100
    
    // Ca buffer
    Ca_tau = 240
    Ca_axon_tau = 43
    
    Ca_soma_brat = 200
    Ca_dend_brat = 50
    Ca_axon_brat = 10
    
    Ca_depth = 0.05
    
    cao0 = 2
    cai0 = 4.8e-05
    
    // Kir21 conductance
    Kir_gkbar = 0.000353903
    Kir_mg_i = 4
    Kir_spm_i = 1
    Kir_gsub = 0.25
    Kir_fac = 0.005
    Kir_vshiftbs = 0
    Kir_vshiftbb = 0
    Kir_b = 0.105
    Kir_shiftmg = 0.5
    Kir_cas = 0.142857
    Kir_As = 0.2
    
    Kir_axon_gkbar = 0.000168525
    
    // Kv42 conductance
    Kv42_gkbar = 0.002175
    Kv42_a0 = 0.416
    Kv42_za = 1.1
    Kv42_b0 = 0.0486
    Kv42_zb = -1.556
    Kv42_kco0 = 0.347
    Kv42_zco = 0
    Kv42_koc0 = 1.67
    Kv42_zoc = 0
    Kv42_kci = 0.04873
    Kv42_kic = 0.000537
    Kv42_koi = 0.0669
    Kv42_kio = 0.04246
