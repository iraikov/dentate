    Kv723_Dtaumult2 = 6
    Kv723_tau0mult = 0.2
    
    // Cav12 conductance
    Cav12_gbar = 1e-05
    Cav12_kf = 0.0005
    Cav12_IML_gbar = 4e-05
    Cav12_MML_gbar = 4e-05
    Cav12_OML_gbar = 4e-05
    
    // Cav13 conductance
    Cav13_gbar = 4e-06
    Cav13_IML_gbar = 8e-06
    Cav13_MML_gbar = 8e-06
    Cav13_OML_gbar = 8e-06
    
