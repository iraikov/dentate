proc celldef() {
    
    GCLidxs = new Vector()
    IMLidxs  = new Vector()
    MMLidxs  = new Vector()
    OMLidxs  = new Vector()
    
    apicalidx = new Vector()
    basalidx  = new Vector()
    somaidx   = new Vector()
    axonidx   = new Vector()
    aisidx    = new Vector()
    hilidx    = new Vector()
    
    parameters()
    shape($o1,$o6,$o7,$o8,$o9)
    topol($o1,$o2,$o3,$o4,$o5,$o10)
//    geom()
    subsets()
    biophys()
}



